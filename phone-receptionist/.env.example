# ── Vapi ──
# Dashboard → API Keys. Used only by scripts/create-assistant.js to provision assistants.
VAPI_API_KEY=

# ── This server ──
PORT=3000
# Public HTTPS URL this server is reachable at once deployed (or an ngrok URL while testing).
# Vapi calls PUBLIC_SERVER_URL + /webhook/<practiceId> during a live call.
PUBLIC_SERVER_URL=https://your-deployed-domain.example.com

# ── Google Calendar (optional, per-practice) ──
# Leave blank to run in "intake mode": booking requests are queued locally for
# staff to confirm instead of writing directly to a calendar. See README.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
